# ================= 依赖 =================
node_modules/
*/node_modules/

# npm 本地缓存（非源码，体积大）
.npm-cache/
*/.npm-cache/
.npm/
*/.npm/

# ================= 构建产物 =================
dist/
build/
*.tsbuildinfo

# ================= 环境变量（含密钥，绝不入库）=================
# 保留 .env.example 作为模板，其余本地环境文件一律忽略
.env
.env.local
.env.*.local
# 生产环境文件（systemd / 容器注入用），真实密钥绝不入库
.env.production
backend/.env.production
frontend/.env.production
deploy/.env
deploy/env/*.env
!deploy/env/*.example

# ================= 数据库 =================
*.db
*.db-journal
*.sqlite
*.sqlite3

# ================= 日志 =================
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
smoke-final.log

# ================= 编辑器 / 系统 =================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ================= 工作区数据（备份、记忆、临时产物）=================
.workbuddy/

# ================= 本地预览产物 =================
coverage/
.nyc_output/
