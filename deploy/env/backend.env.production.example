# ============================================================
# 后端生产环境变量模板（路线 A：原生部署）
#
# 安装：
#   sudo mkdir -p /etc/intimate-commerce
#   sudo cp deploy/env/backend.env.production.example /etc/intimate-commerce/backend.env
#   sudo chmod 600 /etc/intimate-commerce/backend.env
#   sudo chown root:intimate /etc/intimate-commerce/backend.env
#   sudo nano /etc/intimate-commerce/backend.env   # 把所有 CHANGE_ME 换掉
#
# 重要：本文件由 systemd EnvironmentFile 注入。
# 经核实 @nestjs/config 的加载逻辑为 { ...文件变量, ...process.env }，
# 因此 systemd 注入的变量优先级高于 backend/.env 与 backend/.env.local。
# 但为避免歧义，部署目录中不应保留任何 .env / .env.local（deploy.sh 会自动改名隔离）。
#
# 语法注意：systemd EnvironmentFile 不支持 ${VAR} 变量展开；
#         含空格、# 的值必须用双引号包裹；# 只有行首才算注释。
# ============================================================

# ---------- 运行时 ----------
# 必须为 production，否则真实销售开放门槛会整体失效
APP_ENV="production"
APP_PORT=3000
APP_URL="https://shop.example.com"
FRONTEND_URL="https://shop.example.com"
# 只允许正式前端域名，直接写 IP 或 localhost 会让线上 CORS 失效
CORS_ORIGINS="https://shop.example.com"

# 反代只有一跳（宿主 Nginx）时填 1，否则限流会把所有请求算到 Nginx 同一 IP 上；
# 若后端不经过任何反代则填 0
TRUST_PROXY_HOPS=1

# ---------- 数据库 ----------
# 生产库与开发库必须是两个独立的库，不要克隆含演示数据的开发库
DATABASE_URL="mysql://intimate_commerce:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/intimate_commerce_prod?schema=public&connection_limit=10"

# ---------- 缓存 ----------
# 留空或填 none 会自动降级为进程内内存缓存（仅单实例安全）
# 本方案是单实例部署，因此 Redis 可选
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD="CHANGE_ME_REDIS_PASSWORD"

# ---------- 鉴权 ----------
# 必须重新生成，不要沿用本占位值： openssl rand -base64 48
# 注意：本占位串刻意包含 "change-me"，因为应用启动校验会拒绝含该字样或长度 < 32 的密钥。
#      不改掉它，生产环境会直接启动失败 —— 这是有意设计的第二道防线。
JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-base64-48"
JWT_ACCESS_EXPIRES_IN="15m"

# ---------- 店铺展示 ----------
STORE_NAME="The Intimate Edit"
STORE_SUPPORT_EMAIL="support@shop.example.com"
STORE_SHIPPING_CENTS=695
STORE_FREE_SHIPPING_CENTS=7500
STORE_DISCREET_PACKAGING=false
STORE_SHIPPING_NOTICE=""
STORE_RETURNS_NOTICE=""
STORE_PRIVACY_NOTICE=""
STORE_TERMS_NOTICE=""

# ---------- 真实销售门槛 ----------
# 这四项是防误开门槛，不是系统能自动确认的法律结论。
# 不要为了"让它跑起来"而随意填 true —— 填 true 且 COMMERCE_LIVE_ENABLED=true
# 会直接对真实用户开放收款通道。
COMMERCE_LIVE_ENABLED=false
PAYMENT_CATEGORY_APPROVED=false
PRODUCT_COMPLIANCE_CONFIRMED=false
LEGAL_REVIEW_CONFIRMED=false
TAX_REVIEW_CONFIRMED=false

# ---------- 支付 ----------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- 邮件出站（二选一，或都留空则只进 StoreMail 发件箱） ----------
# 1) Resend（生产推荐）：同时必须填下面的 MAIL_FROM
RESEND_API_KEY=""
# 2) 自建 / 托管 SMTP
DEV_SMTP_HOST=""
DEV_SMTP_PORT=""
DEV_SMTP_USER=""
DEV_SMTP_PASS=""

# 真实模式必须有真实且已验证的发件地址
MAIL_FROM="no-reply@shop.example.com"
MAIL_FROM_NAME="The Intimate Edit"

# ---------- 管理员初始化 ----------
# 仅在 `npx prisma db seed` 时使用。
# 生产模式下 seed 强制要求：ADMIN_EMAIL 非空，且 ADMIN_PASSWORD 长度 >= 14，
# 否则直接报错退出（不会静默生成弱口令）。
# 已存在的账号不会被重置（seed 使用 upsert + 空 update）。
ADMIN_EMAIL="ops@shop.example.com"
ADMIN_PASSWORD="CHANGE_ME_AT_LEAST_14_CHARS"

# ---------- 已废弃，不要从旧 .env 复制过来 ----------
# PROXYLINE_API_BASE_URL / PROXYLINE_API_KEY / PROXYLINE_BALANCE_ALERT_THRESHOLD_USD
# 属于旧 Proxy IP 业务遗留变量，当前代码已完全不读取。
