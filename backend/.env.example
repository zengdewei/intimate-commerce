# Local development — requires a running MySQL 8.0+ server on port 3306.
# Format: mysql://<user>:<password>@localhost:3306/<database_name>?schema=public&connection_limit=10
# Example:
#   CREATE DATABASE intimate_commerce_dev CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:123456@localhost:3306/intimate_commerce_dev?schema=public&connection_limit=10"
APP_ENV="development"
APP_PORT=3000
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
TRUST_PROXY_HOPS=0
JWT_ACCESS_SECRET="change-me-development-only-xxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
REDIS_HOST="none"

# Display name only; final branding has not been selected.
STORE_NAME="The Intimate Edit"
STORE_SUPPORT_EMAIL=""
STORE_SHIPPING_CENTS=695
STORE_FREE_SHIPPING_CENTS=7500
STORE_DISCREET_PACKAGING=false
STORE_SHIPPING_NOTICE=""
STORE_RETURNS_NOTICE=""
STORE_PRIVACY_NOTICE=""
STORE_TERMS_NOTICE=""

# No live transactions until business approval and integration testing.
COMMERCE_LIVE_ENABLED=false
PAYMENT_CATEGORY_APPROVED=false
PRODUCT_COMPLIANCE_CONFIRMED=false
LEGAL_REVIEW_CONFIRMED=false
TAX_REVIEW_CONFIRMED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email delivery: pick ONE of the following outbound channels (or leave both blank to keep messages in StoreMail outbox only).
# 1) Resend (recommended) — also requires MAIL_FROM below.
RESEND_API_KEY=""
# 2) SMTP fallback, e.g. local MailHog (http://localhost:8025) at host 127.0.0.1 port 1025.
#    Production may point to a self-hosted or managed SMTP service that accepts STARTTLS on the given port.
#    Fill DEV_SMTP_USER / DEV_SMTP_PASS only if your SMTP server requires AUTH.
DEV_SMTP_HOST=""
DEV_SMTP_PORT=""
DEV_SMTP_USER=""
DEV_SMTP_PASS=""

# "From" header used for all outbound commerce and auth emails.
# Live mode requires a real, verified sender address (Resend verified domain or SMTP-accepted envelope).
# Development: if left empty, defaults to no-reply@local.dev; still acceptable because outbox-only or MailHog.
MAIL_FROM=""
MAIL_FROM_NAME="The Intimate Edit"

# Leave blank locally for demo defaults. Production seed requires both.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
