# ============================================================
# 后端预览环境变量模板（无域名 / HTTP over IP）
#
# 适用场景：新服务器，暂无域名，只想先把项目跑起来做联调或演示。
# 安装：
#   sudo mkdir -p /etc/intimate-commerce
#   sudo cp deploy/env/backend.env.preview.example /etc/intimate-commerce/backend.env
#   sudo chmod 600 /etc/intimate-commerce/backend.env
#   sudo chown root:intimate /etc/intimate-commerce/backend.env
#   sudo nano /etc/intimate-commerce/backend.env
#
# 与 production 模板的关键区别：
#   - APP_ENV=development（绕过应用对 FRONTEND_URL 必须 https 的硬性校验）
#   - FRONTEND_URL / CORS_ORIGINS 用 http://<服务器公网IP>
#   - 不签发证书、不配置 Stripe 真实密钥、COMMERCE_LIVE_ENABLED=false
#   - 演示账号与演示商品会被 seed 创建（生产模式会跳过）
#
# 安全提醒：HTTP 下 JWT 与登录口令可被嗅探，预览库不要录入真实数据。
# 拿到域名后，用 backend.env.production.example 重做配置并切到 production 模式。
# ============================================================

# ---------- 运行时 ----------
APP_ENV="development"
APP_PORT=3000
# 把 <SERVER_IP> 换成服务器公网 IP，例如 http://203.0.113.5
APP_URL="http://<SERVER_IP>"
FRONTEND_URL="http://<SERVER_IP>"
CORS_ORIGINS="http://<SERVER_IP>"
# 仍由宿主 Nginx 反代一跳，必须设 1
TRUST_PROXY_HOPS=1

# ---------- 数据库 ----------
# 与开发库分开，避免污染；密码请改成强密码
DATABASE_URL="mysql://intimate_commerce:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/intimate_commerce_preview?schema=public&connection_limit=10"

# ---------- 缓存 ----------
# 预览可不必装 Redis，留空即用进程内内存缓存
REDIS_HOST="none"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ---------- 鉴权 ----------
# 即便是预览也部署在公网 IP 上，必须用强密钥：openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-generate-with-openssl-rand-base64-48"
JWT_ACCESS_EXPIRES_IN="15m"

# ---------- 店铺展示 ----------
STORE_NAME="The Intimate Edit"
STORE_SUPPORT_EMAIL="support@example.com"
STORE_SHIPPING_CENTS=695
STORE_FREE_SHIPPING_CENTS=7500
STORE_DISCREET_PACKAGING=false
STORE_SHIPPING_NOTICE=""
STORE_RETURNS_NOTICE=""
STORE_PRIVACY_NOTICE=""
STORE_TERMS_NOTICE=""

# ---------- 真实销售门槛（预览一律保持 false）----------
COMMERCE_LIVE_ENABLED=false
PAYMENT_CATEGORY_APPROVED=false
PRODUCT_COMPLIANCE_CONFIRMED=false
LEGAL_REVIEW_CONFIRMED=false
TAX_REVIEW_CONFIRMED=false
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- 邮件 ----------
# 预览不外发邮件，订单/找单/重置邮件只进 StoreMail 表，
# 可用 `npx prisma studio` 打开 StoreMail 表查看 text 字段里的私密链接/验证码。
RESEND_API_KEY=""
DEV_SMTP_HOST=""
DEV_SMTP_PORT=""
DEV_SMTP_USER=""
DEV_SMTP_PASS=""
MAIL_FROM=""
MAIL_FROM_NAME="The Intimate Edit"

# ---------- 管理员 ----------
# 预览模式 seed 不强制长度；为空时回退到默认口令 Admin@123456。
# 但公网部署强烈建议设一个 >= 14 位的强口令。
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
