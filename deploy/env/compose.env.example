# ============================================================
# Docker Compose 变量文件模板（路线 B：容器部署）
#
# 安装：
#   cp deploy/env/compose.env.example deploy/.env
#   nano deploy/.env
#   chmod 600 deploy/.env
#
# 说明：docker compose 会自动读取 compose 文件同目录下的 .env，
#      这些变量用于填充容器名/端口/MySQL 账号密码等编排参数。
#      应用自身的业务变量在 deploy/env/backend.env（对应 env_file）。
# ============================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=intimate_commerce_prod
MYSQL_USER=intimate_commerce
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ---------- 对外端口 ----------
# 只监听回环地址，由宿主 Nginx 负责 TLS 终结后转发，
# 不要把 8080 直接暴露到公网。
WEB_BIND=127.0.0.1:8080
